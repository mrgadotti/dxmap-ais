[Unit]
Description=DXMaps AIS DX reporter (AIS-catcher UDP -> dxmaps.com)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dxmaps
Group=dxmaps
WorkingDirectory=/opt/dxmaps
Environment=HOME=/var/lib/dxmaps
Environment=UV_CACHE_DIR=/var/lib/dxmaps/.cache/uv
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/local/bin/uv run --script /opt/dxmaps/ais_dxmaps.py --config /etc/dxmaps/dxmaps.conf
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/dxmaps

[Install]
WantedBy=multi-user.target
